# Frontend (public - exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SIGNALING_URL=wss://localhost:4000

# Backend (secrets - server only)
# NOTE: SUPABASE_SERVICE_ROLE_KEY must NEVER be used in frontend/
PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=username
TURN_CREDENTIAL=credential
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_secret
STRIPE_SECRET_KEY=sk_test_key
STRIPE_WEBHOOK_SECRET=whsec_key
ROOM_TTL_MINUTES=60
SAVED_FILE_TTL_HOURS=48
